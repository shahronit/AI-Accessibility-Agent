rules_version = '2';

// A11yAgent Firestore security rules.
//
// All actual reads/writes go through the Firebase Admin SDK on the
// server (see lib/db.ts). The Admin SDK bypasses these rules, so the
// rules below are deliberately strict — they exist to lock the database
// down against any direct client-side traffic that bypasses the API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
